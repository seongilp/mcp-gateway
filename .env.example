# 복사해서 .env로 사용: cp .env.example .env

# ── LiteLLM 게이트웨이용 ──
# 마스터 키. 클라이언트 인증 + UI 로그인에 사용. 운영 시 긴 랜덤 문자열로 교체.
LITELLM_MASTER_KEY=sk-1234

# ── (보존) Bifrost 게이트웨이용 ──
# bifrost UI에 저장되는 키/시크릿 암호화용 (운영 권장). 임의의 긴 문자열.
BIFROST_ENCRYPTION_KEY=change-me-to-a-long-random-string

# ── BigQuery 예시 MCP 서버용 ──
# 쿼리 대상 GCP 프로젝트 ID
BIGQUERY_PROJECT=your-gcp-project-id
